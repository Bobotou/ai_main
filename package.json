{
  "name": "ai-mail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "个人智能邮箱客户端 - Web",
  "scripts": {
    "dev": "pnpm --filter @ai-mail/mail-core build && pnpm --parallel --filter @ai-mail/server --filter @ai-mail/web dev",
    "dev:server": "pnpm --filter @ai-mail/server dev",
    "dev:web": "pnpm --filter @ai-mail/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @ai-mail/server prisma:migrate",
    "db:generate": "pnpm --filter @ai-mail/server prisma:generate",
    "infra": "docker compose up -d postgres redis meilisearch",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
